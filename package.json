{
  "name": "@astra-spec/astra-theme",
  "version": "0.1.0",
  "description": "A rich MyST web theme for ASTRA analyses — the presentation half of the @astra-spec/mystra pair.",
  "license": "BSD-3-Clause",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "remix vite:build",
    "start": "node ./server.js",
    "dev": "remix vite:dev",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astra-spec/store-types": "workspace:*",
    "@myst-theme/site": "^1.1.0",
    "@myst-theme/providers": "^1.1.0",
    "@myst-theme/book": "^1.1.0",
    "@myst-theme/jupyter": "^1.1.0",
    "@myst-theme/landing-pages": "^1.1.0",
    "@myst-theme/anywidget": "^1.1.0",
    "@myst-theme/search": "^1.1.0",
    "@myst-theme/search-minisearch": "^1.1.0",
    "myst-to-react": "^1.1.0",
    "myst-common": "^1.5.0",
    "@floating-ui/react": "^0.26.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@remix-run/node": "^2.10.0",
    "@remix-run/react": "^2.10.0",
    "@remix-run/express": "^2.10.0",
    "express": "^4.19.0",
    "compression": "^1.7.4",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.10.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/express": "^4.17.0",
    "@types/compression": "^1.7.0",
    "@types/morgan": "^1.9.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vite-tsconfig-paths": "^4.3.0"
  }
}
