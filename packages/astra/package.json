{
  "name": "@astra-spec/theme-astra",
  "version": "0.0.16",
  "description": "The shared ASTRA overlay for MyST themes: publication rehydration, ASTRA renderers, shared UI integration, and Lightcone branding.",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/astra.css": "./styles/astra.css"
  },
  "bin": {
    "copy-pdfjs-assets": "./scripts/copy-pdfjs-assets.mjs",
    "relativize-css-assets": "./scripts/relativize-css-assets.mjs"
  },
  "files": [
    "scripts",
    "src",
    "styles"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@astra-spec/mystra": "https://pkg.pr.new/astra-project/MySTRA/@astra-spec/mystra@c16e9393f19c744cea940f6b9e5a526120481f40",
    "@astra-spec/sdk": "0.2.0-rc1",
    "@astra-spec/ui": "https://pkg.pr.new/astra-project/astra-ui/@astra-spec/ui@3094ce3d7a2d199f409cd7d0ab05c0c0cce71e76",
    "@lightcone-research/brand": "0.0.3",
    "@myst-theme/providers": "^1.3.1",
    "myst-common": "^1.8.1",
    "myst-to-react": "^1.3.1",
    "pdfjs-dist": "4.8.69"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
