{
  "name": "@astra-spec/theme-astra",
  "version": "0.0.7",
  "description": "The ASTRA overlay shared by the astra themes: glyph-tagged inline references, preview cards, decision/finding/output renderers, the resolved-store provider, and the ASTRA stylesheet. Consumed as TypeScript source — the themes' Remix builds bundle it.",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/astra.css": "./styles/astra.css"
  },
  "files": [
    "src",
    "styles"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@astra-spec/store-types": "*",
    "@floating-ui/react": "^0.27.0",
    "@myst-theme/common": "^1.3.1",
    "@myst-theme/providers": "^1.3.1",
    "doi-utils": "^2.0.6",
    "katex": "^0.16.22",
    "myst-common": "^1.8.1",
    "myst-config": "^1.8.1",
    "myst-to-react": "^1.3.1"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
