# The @myst-theme/* packages declare React 16–18 peer ranges but ship and run on
# React 19 (matching @myst-theme/book). npm's strict peer resolver rejects that;
# bun (which the upstream theme uses) does not. legacy-peer-deps makes npm install
# AND `npm ci` (run by myst's build.install) behave like the supported setup.
legacy-peer-deps=true

# Pack sibling file: dependencies into this install instead of symlinking their
# working trees. This keeps React peer imports on the theme's single hoisted
# React instance during Remix SSR while the coordinated packages are developed
# and reviewed together before publication.
install-links=true
