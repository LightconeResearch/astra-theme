    "@myst-theme/common": "^1.3.1",
    "@myst-theme/providers": "^1.3.1",
    "doi-utils": "^2.0.6",
    "katex": "^0.16.22",
    "myst-common": "^1.8.1",
    "myst-config": "^1.8.1",
    "myst-to-react": "^1.3.1"
  },
  "peerDependencies": {
    "react": ">=18"
  }
