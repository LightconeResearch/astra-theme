{
  "name": "@astra-spec/astra-theme",
  "version": "0.0.8",
  "description": "Paper-only MyST publication themes for ASTRA analyses: article and book templates layered over the MySTRA document projection.",
  "license": "BSD-3-Clause",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "themes/*"
  ],
  "scripts": {
    "build": "npm run sync:siblings && npm run build:article && npm run build:book",
    "build:article": "npm run build -w themes/article",
    "build:book": "npm run build -w themes/book",
    "dev:article": "npm run dev -w themes/article",
    "dev:book": "npm run dev -w themes/book",
    "start:article": "npm run start -w themes/article",
    "start:book": "npm run start -w themes/book",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "npm run clean --workspaces --if-present",
    "postinstall": "patch-package && mkdir -p themes/article/node_modules themes/book/node_modules",
    "sync:siblings": "node scripts/sync-siblings.mjs"
  },
  "devDependencies": {
    "@astra-spec/sdk": "file:../astra-typescript",
    "@lightcone-research/astra-ui": "file:../astra-ui/packages/react",
    "@lightcone-research/lightcone-brand": "file:../lightcone-brand",
    "@remix-run/dev": "~1.19.0",
    "@tailwindcss/typography": "^0.5.9",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node-fetch": "^2.6.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^29.1.1",
    "patch-package": "^8.0.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "vitest": "^2.1.9"
  },
  "comments": {
    "overrides": "Force a single React 19 across the whole tree — jupyterlab/thebe deps pull React 18, which would bundle multiple React copies into the server build and break SSR hooks. Mirrors @myst-theme upstream.",
    "postinstall": "The empty themes/*/node_modules dirs make a built local checkout directly usable as site.template: myst skips its template install step when node_modules exists (deps are hoisted to the repo root)."
  },
  "overrides": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3"
  }
}
