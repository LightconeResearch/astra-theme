# ---- dependencies ----
node_modules/

# ---- Remix build output + generated assets (reproduce with `npm run build`) ----
/build/
# /public/ is entirely generated: Remix client build + copied thebe assets
/public/
# Remix compiler cache
/.cache/
# tailwind output (source is styles/app.css)
/app/styles/app.css
# copied from remix.config.prod.js by `npm run prod:copy`
/remix.config.js
*.tsbuildinfo
packages/*/dist/

# ---- MyST engine artifacts (created when running a project against the theme) ----
_build/
.myst.session.json

# ---- examples (local demo projects; not part of the published theme) ----
examples

# ---- local tooling / scratch ----
.playwright-mcp/
*.log
.env
.env.*
!.env.example

# ---- editor / OS ----
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*~

# ---- design source (large binary; not needed to build) ----
*.fig
