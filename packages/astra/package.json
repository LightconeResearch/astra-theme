{
  "name": "@astra-spec/theme-astra",
  "version": "0.0.16",
  "description": "The shared ASTRA overlay for MyST themes: publication rehydration, ASTRA renderers, shared UI integration, and Lightcone branding.",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/astra.css": "./styles/astra.css"
  },
  "bin": {
    "copy-pdfjs-assets": "./scripts/copy-pdfjs-assets.mjs",
    "relativize-css-assets": "./scripts/relativize-css-assets.mjs"
  },
  "files": [
    "scripts",
    "src",
    "styles"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@astra-spec/sdk": "git+https://github.com/astra-project/astra-typescript.git#d8ef3bf7e3c28086e38222925107ada0e8f1ef85",
    "@astra-spec/ui": "https://pkg.pr.new/@astra-spec/ui@77249f9bfb478f2729dfd58ff097c59fd5a9c969",
    "@lightcone-research/brand": "0.0.3",
    "@myst-theme/providers": "^1.3.1",
    "myst-common": "^1.8.1",
    "myst-to-react": "^1.3.1",
    "pdfjs-dist": "4.8.69"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
