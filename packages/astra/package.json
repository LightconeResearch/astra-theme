{
  "name": "@astra-spec/theme-astra",
  "version": "0.0.10",
  "description": "The shared ASTRA overlay for MyST themes: publication rehydration, ASTRA renderers, shared UI integration, and Lightcone branding.",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./styles/astra.css": "./styles/astra.css"
  },
  "bin": {
    "copy-pdfjs-assets": "./scripts/copy-pdfjs-assets.mjs"
  },
  "files": [
    "scripts",
    "src",
    "styles"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "@astra-spec/sdk": "^0.1.2",
    "@astra-spec/ui": "https://pkg.pr.new/@astra-spec/ui@d9645a0",
    "@lightcone-research/brand": "git+https://github.com/LightconeResearch/brand.git#2c142328a45378f6b6397a67537f9bca454f7a9a",
    "@myst-theme/providers": "^1.3.1",
    "myst-common": "^1.8.1",
    "myst-to-react": "^1.3.1",
    "pdfjs-dist": "4.8.69"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  }
}
