{
  "name": "@astra-spec/store-types",
  "version": "0.0.1",
  "description": "Type-checked mirror of the MySTRA plugin's resolved-store shape, shared by the @astra-spec/mystra plugin and the astra-theme.",
  "license": "BSD-3-Clause",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
